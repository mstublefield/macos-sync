<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mstublefield.studio-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>$HOME/Development/studio-sync/sync-from-studio.sh</string>
    </array>

    <!-- Run on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Run when network configuration changes (WiFi connect/disconnect) -->
    <key>WatchPaths</key>
    <array>
        <string>/Library/Preferences/SystemConfiguration</string>
    </array>

    <!-- Also run hourly as a fallback -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Coalesce WatchPath triggers: at most one run per 5 minutes.
         configd writes to /Library/Preferences/SystemConfiguration on every
         DHCP renew, WiFi roam, DNS update, etc. — without throttling, this
         fires the agent every 2-4 minutes. -->
    <key>ThrottleInterval</key>
    <integer>300</integer>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/Users/mstublefield/Library/Logs/studio-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mstublefield/Library/Logs/studio-sync.log</string>
</dict>
</plist>
